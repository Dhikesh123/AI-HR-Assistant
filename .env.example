# ---------------------------------------------------------------------------
# AI HR Assistant - environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_NAME=AI HR Assistant
COMPANY_NAME=ACME Corporation
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM -------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run in offline extractive mode (still grounded,
# still cites sources - useful for demos without an API key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600

# --- Embeddings ------------------------------------------------------------
# auto | openai | sentence_transformers | local
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=512

# --- RAG -------------------------------------------------------------------
TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_RELEVANCE_SCORE=0.15
CHROMA_COLLECTION=hr_documents
HISTORY_TURNS=4

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./hr_assistant.db

# --- Auth ------------------------------------------------------------------
JWT_SECRET_KEY=change_this_secret_before_deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=20

# --- Demo accounts (created on first run) ----------------------------------
SEED_ADMIN_EMAIL=admin@acme.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_EMPLOYEE_EMAIL=employee@acme.com
SEED_EMPLOYEE_PASSWORD=Employee@123

# --- Frontend --------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
